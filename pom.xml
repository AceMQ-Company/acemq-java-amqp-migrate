<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.acemq</groupId>
  <artifactId>acemq-java-amqp-migrate</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AceMQ migration agent</name>
  <description>Reads a Java codebase that uses Spring AMQP, the RabbitMQ Java client or JMS and
    writes a migration report to AceMQ: what maps to what, what has no equivalent, the order to
    take the steps in, and the risks. A local model (Ollama) for the parts that need judgment;
    nothing leaves the machine.</description>
  <url>https://acemq.org/</url>

  <organization>
    <name>AceMQ</name>
    <url>https://acemq.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Felipe Gutierrez</name>
      <organization>AceMQ</organization>
      <organizationUrl>https://acemq.com</organizationUrl>
    </developer>
  </developers>

  <!-- Its own version line, starting at 0.1.0. -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Java 17: a command a person runs, not a library an application links, so the
         libraries' Java 11 baseline does not apply. -->
    <maven.compiler.release>17</maven.compiler.release>

    <ai.version>0.1.1</ai.version>
    <slf4j.version>2.0.20</slf4j.version>

    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
  </properties>

  <!-- The acemq.org feed, served from GitHub Pages. Distribution is GitHub-hosted only. -->
  <repositories>
    <repository>
      <id>acemq</id>
      <url>https://acemq.org/maven/</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- The model client, the Ollama adapter and the egress guard (acemq-java-amqp-ai). -->
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-ai-core</artifactId>
      <version>${ai.version}</version>
    </dependency>
    <!-- stdout carries the report, so logging goes to stderr: slf4j-simple's default. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-ai-test</artifactId>
      <version>${ai.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>
      <!-- The runnable jar, attached as the "all" classifier:
           java -jar acemq-java-amqp-migrate-<version>-all.jar <source-dir> -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.acemq.migrate.Migrate</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
